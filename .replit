modules = ["nodejs-24", "python-3.12", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "migration-browser"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "joy-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "deployment-safety"

[[workflows.workflow]]
name = "migration-browser"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm exec playwright test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "joy-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/joy run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "deployment-safety"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PYTHONPATH=artifacts/api-server uv run --frozen python -m pytest -q artifacts/api-server/tests/test_deployment_guard.py"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["cargo", "libiconv", "libxcrypt", "openssl", "pkg-config", "postgresql", "rustc"]

[userenv]

[userenv.shared]
JOY_INITIAL_ADMIN_EMAIL = "e.h.ifti@gmail.com"
META_LOGIN_CONFIG_ID = "935054449441104"
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID = "1423530453086604"
