# Project JOY Configuration
PROJECT_NAME="JOY"
ENVIRONMENT="development"
DEBUG=true

# Database & Cache (for Docker Compose: use postgres & redis service names; for local: localhost)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/joy"
REDIS_URL="redis://localhost:6379/0"

# AI Reasoning & Embeddings
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
OPENAI_API_KEY=""

# Telephony & Voice (LiveKit + Bangladeshi SIP AmberIT / Telnyx)
TELEPHONY_API_KEY=""
TELEPHONY_PHONE_NUMBER=""
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
SIP_TRUNK_PROVIDER="AmberIT"

# Social Channels (Meta Graph API)
META_APP_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN="joy_meta_verify_token_default"

# Storefront Integrations
SHOPIFY_API_SECRET=""
WOOCOMMERCE_WEBHOOK_SECRET=""

# Auth & Security
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
ENCRYPTION_KEY_SECRET="joy_master_aes256_secret_key_change_in_production_32b"
